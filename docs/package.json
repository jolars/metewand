{
  "name": "metewand-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node .vitepress/prepare-assets.mjs && vitepress dev",
    "build": "node .vitepress/prepare-assets.mjs && vitepress build && node scripts/prepare-markdown.mjs",
    "preview": "vitepress preview",
    "deploy:check": "npm run build && npm test && cf deploy --dry-run",
    "deploy": "npm run build && cf deploy",
    "test": "node --test --test-timeout=60000 tests/*.test.mjs",
    "preview:worker": "cf dev"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.19",
    "cheerio": "^1.2.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vitepress": "1.6.4",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
