{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "complete": { "const": true },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": { "path": { "const": "data.json" } },
        "required": ["path"]
      }
    }
  },
  "required": ["schema_version", "complete", "files"]
}
