{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/bundle-output.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand bundle-output",
  "type": "object",
  "properties": {
    "command": {
      "const": "bundle"
    },
    "dry_run": {
      "type": "boolean"
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "bundle": {
      "$ref": "bundle-manifest.schema.json"
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "command",
    "dry_run",
    "destination",
    "bundle",
    "next_steps"
  ],
  "additionalProperties": false
}
