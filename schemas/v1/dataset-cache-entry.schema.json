{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/dataset-cache-entry.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Dataset derivation cache mapping",
  "type": "object",
  "properties": {
    "schema_version": {
