{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/bundle-manifest.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand bundle-manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runner_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "builder_image": {
      "type": "string",
      "minLength": 1
    },
    "base_image": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "directory"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "file"
              },
              "path": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "path",
              "sha256",
              "size_bytes",
              "executable"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "runner_version",
    "builder_image",
    "base_image",
    "manifest",
    "entries"
  ],
  "additionalProperties": false
}
