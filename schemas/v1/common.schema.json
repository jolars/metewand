{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/common.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand version 1 shared schema definitions",
  "$defs": {
    "native_absolute_path": {
      "type": "string",
      "anyOf": [
        {
          "pattern": "^/"
        },
        {
          "pattern": "^[A-Za-z]:[\\\\/]"
        },
        {
          "pattern": "^\\\\\\\\[^\\\\/]+[\\\\/][^\\\\/]+"
        }
      ]
    },
    "compact_type": {
      "enum": ["number", "integer", "string", "boolean", "null", "array"]
    },
    "compact_field_schema": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/compact_type" },
        "enum": { "type": "array", "minItems": 1 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "multipleOf": { "type": "number", "exclusiveMinimum": 0 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string" },
        "items": { "$ref": "#/$defs/compact_item" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "uniqueItems": { "type": "boolean" }
      },
      "required": ["type"],
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["number", "integer"] } } },
          "else": {
            "not": { "anyOf": [
              { "required": ["minimum"] }, { "required": ["maximum"] },
              { "required": ["exclusiveMinimum"] }, { "required": ["exclusiveMaximum"] },
              { "required": ["multipleOf"] }
            ] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "else": {
            "not": { "anyOf": [
              { "required": ["minLength"] }, { "required": ["maxLength"] },
              { "required": ["pattern"] }
            ] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "array" } } },
          "then": { "required": ["items"] },
          "else": {
            "not": { "anyOf": [
              { "required": ["items"] }, { "required": ["minItems"] },
              { "required": ["maxItems"] }, { "required": ["uniqueItems"] }
            ] }
          }
        }
      ]
    },
    "compact_item": {
      "oneOf": [
        { "enum": ["number", "integer", "string", "boolean", "null"] },
        {
          "allOf": [{ "$ref": "#/$defs/compact_field_schema" }],
          "unevaluatedProperties": false
        }
      ]
    },
    "compact_field": {
      "oneOf": [
        { "enum": ["number", "integer", "string", "boolean", "null"] },
        {
          "allOf": [
            { "$ref": "#/$defs/compact_field_schema" },
            {
              "properties": {
                "default": true,
                "grid": { "type": "array", "minItems": 1 },
                "optional": { "type": "boolean" }
              },
              "not": { "required": ["default", "grid"] }
            }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "compact_parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/compact_field" }
    },
    "compact_output_field": {
      "oneOf": [
        { "enum": ["number", "integer", "string", "boolean", "null"] },
        {
          "allOf": [
            { "$ref": "#/$defs/compact_field_schema" },
            { "properties": { "optional": { "type": "boolean" } } }
          ],
          "unevaluatedProperties": false
        }
      ]
    },
    "compact_outputs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/compact_output_field" }
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safe_positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "^[^/\\\\]" },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "/$" } }
      ]
    },
    "repository_root_path": {
      "oneOf": [
        { "const": "." },
        { "$ref": "#/$defs/repository_path" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^mw1-[a-z][a-z0-9-]*-[0-9a-f]{64}$"
    },
    "schema_reference": {
      "$ref": "#/$defs/repository_path"
    },
    "schema_declaration": {
      "description": "A repository schema path or an inline Draft 2020-12 schema. Inline schemas inherit the dialect.",
      "oneOf": [
        { "$ref": "#/$defs/schema_reference" },
        { "type": ["object", "boolean"] }
      ]
    },
    "file_representation": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "array",
          "items": { "$ref": "#/$defs/safe_nonnegative_integer" }
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_order": {
          "type": "string",
          "enum": ["little", "big", "not_applicable"]
        },
        "sparse_layout": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "representation": { "$ref": "#/$defs/file_representation" }
      },
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["id", "path", "sha256"],
      "additionalProperties": false
    },
    "source_span": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "line": { "$ref": "#/$defs/safe_positive_integer" },
        "column": { "$ref": "#/$defs/safe_positive_integer" },
        "end_line": { "$ref": "#/$defs/safe_positive_integer" },
        "end_column": { "$ref": "#/$defs/safe_positive_integer" }
      },
      "required": ["path", "line", "column", "end_line", "end_column"],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": { "type": "object" },
        "source_span": { "$ref": "#/$defs/source_span" },
        "affected_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "uniqueItems": true
        },
        "causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "wire_protocol_version": {
          "type": "integer",
          "const": 1
        },
        "execution_semantics_version": {
          "type": "integer",
          "enum": [1, 2]
        },
        "data": {
          "type": "object",
          "properties": {
            "measurements": { "$ref": "#/$defs/execution_measurements" }
          }
        }
      },
      "required": [
        "tool_version",
        "wire_protocol_version",
        "execution_semantics_version",
        "data"
      ],
      "additionalProperties": false
    },
    "measurement": {
      "description": "Executor-observed nanoseconds or bytes; partial values never claim complete accounting.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "complete"
            },
            "value": {
              "$ref": "#/$defs/safe_nonnegative_integer"
            }
          },
          "required": [
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "partial"
            },
            "value": {
              "$ref": "#/$defs/safe_nonnegative_integer"
            },
            "reason": {
              "enum": [
                "interrupted",
                "process_only"
              ]
            }
          },
          "required": [
            "status",
            "value",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_started",
                "provided_dataset",
                "cache_hit",
                "unsupported",
                "accounting_unavailable",
                "out_of_range"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "execution_measurements": {
      "type": "object",
      "properties": {
        "version": {
          "enum": [1, 2]
        },
        "materialization_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "worker_startup_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "evaluator_startup_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "prepare_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "execute_request_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "timed_wall_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "evaluation_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "cpu_time_ns": {
          "$ref": "#/$defs/measurement"
        },
        "peak_rss_bytes": {
          "$ref": "#/$defs/measurement"
        },
        "cpu_time_scope": {
          "enum": ["prepare_and_execute", "execute_only", "worker_lifetime_through_execute"]
        },
        "peak_rss_scope": {
          "const": "worker_lifetime_through_execute"
        }
      },
      "required": [
        "version",
        "materialization_time_ns",
        "worker_startup_time_ns",
        "evaluator_startup_time_ns",
        "prepare_time_ns",
        "execute_request_time_ns",
        "timed_wall_time_ns",
        "evaluation_time_ns",
        "cpu_time_ns",
        "peak_rss_bytes",
        "cpu_time_scope",
        "peak_rss_scope"
      ],
      "allOf": [
        {
          "if": { "properties": { "version": { "const": 1 } } },
          "then": { "properties": { "cpu_time_scope": { "const": "prepare_and_execute" } } }
        }
      ],
      "additionalProperties": false
    },
    "comparison_row": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "observation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "experiment": {
          "type": [
            "string",
            "null"
          ]
        },
        "case": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation": {
          "type": [
            "string",
            "null"
          ]
        },
        "completion": {
          "type": [
            "string",
            "null"
          ]
        },
        "timing_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "instrumented_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "implementation_repetition": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "measurement_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "timed_wall_time_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "instrumented_time_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "retry_index": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "selected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "metrics": {},
        "diagnostic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          ]
        },
        "timed_wall_time_status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      },
      "required": [
        "candidate_id",
        "attempt_id",
        "status",
        "observation_id",
        "experiment",
        "case",
        "dataset",
        "problem",
        "implementation",
        "completion",
        "timing_scope",
        "instrumented_scope",
        "implementation_repetition",
        "measurement_index",
        "timed_wall_time_ns",
        "instrumented_time_ns",
        "retry_index",
        "valid",
        "selected",
        "parameters",
        "metrics",
        "diagnostic",
        "timed_wall_time_status"
      ],
      "additionalProperties": false
    }
  }
}
