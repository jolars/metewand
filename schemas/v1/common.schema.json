{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/common.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand version 1 shared schema definitions",
  "$defs": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "safe_positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "^[^/\\\\]" },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "/$" } }
      ]
    },
    "repository_root_path": {
      "oneOf": [
        { "const": "." },
        { "$ref": "#/$defs/repository_path" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^mw1-[a-z][a-z0-9-]*-[0-9a-f]{64}$"
    },
    "schema_reference": {
      "$ref": "#/$defs/repository_path"
    },
    "file_representation": {
      "type": "object",
      "properties": {
        "shape": {
          "type": "array",
          "items": { "$ref": "#/$defs/safe_nonnegative_integer" }
        },
        "data_type": {
          "type": "string",
          "minLength": 1
        },
        "byte_order": {
          "type": "string",
          "enum": ["little", "big", "not_applicable"]
        },
        "sparse_layout": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "representation": { "$ref": "#/$defs/file_representation" }
      },
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "additionalProperties": false
    },
    "artifact_reference": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "path": { "$ref": "#/$defs/repository_path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "required": ["id", "path", "sha256"],
      "additionalProperties": false
    },
    "source_span": {
      "type": "object",
      "properties": {
        "path": { "$ref": "#/$defs/repository_path" },
        "line": { "$ref": "#/$defs/safe_positive_integer" },
        "column": { "$ref": "#/$defs/safe_positive_integer" },
        "end_line": { "$ref": "#/$defs/safe_positive_integer" },
        "end_column": { "$ref": "#/$defs/safe_positive_integer" }
      },
      "required": ["path", "line", "column", "end_line", "end_column"],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": { "type": "object" },
        "source_span": { "$ref": "#/$defs/source_span" },
        "affected_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identity" },
          "uniqueItems": true
        },
        "causes": {
          "type": "array",
          "items": { "$ref": "#/$defs/diagnostic" }
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "wire_protocol_version": {
          "type": "integer",
          "const": 1
        },
        "execution_semantics_version": {
          "type": "integer",
          "const": 1
        },
        "data": { "type": "object" }
      },
      "required": [
        "tool_version",
        "wire_protocol_version",
        "execution_semantics_version",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
