{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/managed-output-draft.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand managed output draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "dataset",
        "result",
        "metrics"
      ]
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/repository_path"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "representation": {
            "type": "object"
          }
        },
        "required": [
          "path",
          "media_type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "kind",
    "data",
    "files"
  ],
  "additionalProperties": false
}
