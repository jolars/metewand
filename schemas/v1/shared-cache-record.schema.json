{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/shared-cache-record.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Portable shared artifact cache catalog snapshot",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "roots": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "pending": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "objects",
        "roots",
        "pending"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "previous_sha256",
    "snapshot"
  ],
  "additionalProperties": false
}
