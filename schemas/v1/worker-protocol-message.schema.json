{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/worker-protocol-message.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand version 1 worker protocol message",
  "$defs": {
    "execute_stream_request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "method": {
          "const": "execute_stream"
        },
        "result_root": {
          "$ref": "#/$defs/path"
        },
        "profile": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "method",
        "result_root",
        "profile"
      ],
      "additionalProperties": false
    },
    "stream_checkpoint": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "event": {
          "const": "checkpoint"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "check_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "work": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "terminal": {
          "type": "boolean"
        },
        "manifest": {
          "$ref": "#/$defs/path"
        },
        "draft": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "event",
        "sequence",
        "check_index",
        "work",
        "terminal"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "manifest"
          ],
          "not": {
            "required": [
              "draft"
            ]
          }
        },
        {
          "required": [
            "draft"
          ],
          "not": {
            "required": [
              "manifest"
            ]
          }
        }
      ]
    },
    "stream_decision": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "method": {
          "const": "stream_decision"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "action": {
          "enum": [
            "continue",
            "stop"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "method",
        "sequence",
        "action"
      ],
      "additionalProperties": false
    },
    "execute_stream_response": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "checkpoint_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "ok",
        "checkpoint_count"
      ],
      "additionalProperties": false
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "pattern": "^mw1-resolved-worker-[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "enum": ["dataset_materializer", "implementation", "problem_evaluator"]
    },
    "capability": {
      "type": "string",
      "enum": ["one_shot", "applicability", "fresh_sequence", "streaming_profile", "problem_semantics", "buffered_profile", "managed_outputs"]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sdk": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "manifest_reference": {
      "type": "object",
      "properties": {
        "manifest": { "$ref": "#/$defs/path" }
      },
      "required": ["manifest"],
      "additionalProperties": false
    },
    "worker_failure": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": ["invalid_request", "unsupported_operation", "operation_failed", "internal_error", "resource_limit"]
        },
        "message": { "type": "string", "minLength": 1 },
        "details": { "type": "object" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "hello_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "hello" },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "role": { "$ref": "#/$defs/role" },
        "worker_id": { "$ref": "#/$defs/worker_id" }
      },
      "required": ["id", "method", "protocols", "role", "worker_id"],
      "additionalProperties": false
    },
    "hello_response": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "ok": { "const": true },
        "protocol": { "type": "integer", "const": 1 },
        "worker_id": { "$ref": "#/$defs/worker_id" },
        "sdk": {
          "oneOf": [
            { "$ref": "#/$defs/sdk" },
            { "type": "null" }
          ]
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      },
      "required": ["id", "ok", "protocol", "worker_id", "sdk", "capabilities"],
      "additionalProperties": false
    },
    "materialize_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "materialize" },
        "source_dir": { "$ref": "#/$defs/path" },
        "dataset_parameters": { "$ref": "#/$defs/parameters" },
        "dataset_seed": { "$ref": "#/$defs/safe_nonnegative_integer" },
        "output_dir": { "$ref": "#/$defs/path" }
      },
      "required": [
        "id",
        "method",
        "source_dir",
        "dataset_parameters",
        "dataset_seed",
        "output_dir"
      ],
      "additionalProperties": false
    },
    "prepare_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "prepare" },
        "dataset_dir": { "$ref": "#/$defs/path" },
        "problem_contract_id": { "type": "string", "minLength": 1 },
        "problem_parameters": { "$ref": "#/$defs/parameters" },
        "implementation_parameters": { "$ref": "#/$defs/parameters" },
        "implementation_seed": { "$ref": "#/$defs/safe_nonnegative_integer" }
      },
      "required": [
        "id",
        "method",
        "dataset_dir",
        "problem_contract_id",
        "problem_parameters",
        "implementation_parameters",
        "implementation_seed"
      ],
      "additionalProperties": false
    },
    "execute_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "execute" },
        "result_dir": { "$ref": "#/$defs/path" },
        "observation_control": {
          "type": "object"
        }
      },
      "required": ["id", "method", "result_dir"],
      "additionalProperties": false
    },
    "reset_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "reset" }
      },
      "required": ["id", "method"],
      "additionalProperties": false
    },
    "evaluate_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "evaluate" },
        "dataset_dir": { "$ref": "#/$defs/path" },
        "problem_contract_id": { "type": "string", "minLength": 1 },
        "problem_parameters": { "$ref": "#/$defs/parameters" },
        "problem_semantics": { "type": "object" },
        "result_dir": { "$ref": "#/$defs/path" },
        "metrics_path": { "$ref": "#/$defs/path" }
      },
      "required": [
        "id",
        "method",
        "dataset_dir",
        "problem_contract_id",
        "problem_parameters",
        "result_dir",
        "metrics_path"
      ],
      "additionalProperties": false
    },
    "shutdown_request": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "method": { "const": "shutdown" }
      },
      "required": ["id", "method"],
      "additionalProperties": false
    },
    "evaluate_response": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "ok": { "const": true },
        "verdict": { "enum": ["invalid", "reached", "not_reached", "not_required"] }
      },
      "required": ["id", "ok", "verdict"],
      "additionalProperties": false
    },
    "acknowledgement": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "ok": { "const": true }
      },
      "required": ["id", "ok"],
      "additionalProperties": false
    },
    "materialize_response": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "ok": { "const": true },
        "dataset": { "$ref": "#/$defs/manifest_reference" }
      },
      "required": ["id", "ok", "dataset"],
      "additionalProperties": false
    },
    "execute_response": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "ok": { "const": true },
        "implementation_time_ns": {
          "oneOf": [
            { "$ref": "#/$defs/safe_nonnegative_integer" },
            { "type": "null" }
          ]
        },
        "result": { "$ref": "#/$defs/manifest_reference" },
        "statistics": { "type": "object" },
        "observation_control": {
          "type": "object"
        }
      },
      "required": ["id", "ok", "implementation_time_ns", "result", "statistics"],
      "additionalProperties": false
    },
    "check_applicability_request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "method": {
          "const": "check_applicability"
        },
        "dataset_dir": {
          "$ref": "#/$defs/path"
        },
        "dataset_manifest": {
          "$ref": "#/$defs/path"
        },
        "problem_contract_id": {
          "$ref": "#/$defs/path"
        },
        "problem_parameters": {
          "$ref": "#/$defs/parameters"
        },
        "implementation_parameters": {
          "$ref": "#/$defs/parameters"
        }
      },
      "required": [
        "id",
        "method",
        "dataset_dir",
        "dataset_manifest",
        "problem_contract_id",
        "problem_parameters",
        "implementation_parameters"
      ],
      "additionalProperties": false
    },
    "check_applicability_response": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "outcome": {
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "ok",
        "outcome",
        "code",
        "reason"
      ],
      "additionalProperties": false
    },
    "failure_response": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/request_id" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/worker_failure" }
      },
      "required": ["id", "ok", "error"],
      "additionalProperties": false
    },
    "execute_buffered_request": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "method": {
          "const": "execute_buffered"
        },
        "result_root": {
          "$ref": "#/$defs/path"
        },
        "profile": {
          "$ref": "profile-observation-policy.schema.json#/$defs/selected"
        }
      },
      "required": [
        "id",
        "method",
        "result_root",
        "profile"
      ],
      "additionalProperties": false
    },
    "execute_buffered_response": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "buffer": {
          "$ref": "#/$defs/manifest_reference"
        }
      },
      "required": [
        "id",
        "ok",
        "buffer"
      ],
      "additionalProperties": false
    },
    "managed_execute_response": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "implementation_time_ns": {
          "oneOf": [
            {
              "$ref": "#/$defs/safe_nonnegative_integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "statistics": {
          "type": "object"
        },
        "observation_control": {
          "type": "object"
        },
        "draft": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "ok",
        "implementation_time_ns",
        "statistics",
        "draft"
      ],
      "additionalProperties": false
    },
    "managed_materialize_response": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "draft": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "ok",
        "draft"
      ],
      "additionalProperties": false
    },
    "managed_evaluate_response": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/request_id"
        },
        "ok": {
          "const": true
        },
        "verdict": {
          "enum": [
            "invalid",
            "reached",
            "not_reached",
            "not_required"
          ]
        },
        "draft": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "ok",
        "verdict",
        "draft"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/hello_request" },
    { "$ref": "#/$defs/hello_response" },
    { "$ref": "#/$defs/materialize_request" },
    { "$ref": "#/$defs/prepare_request" },
    { "$ref": "#/$defs/execute_request" },
    { "$ref": "#/$defs/reset_request" },
    { "$ref": "#/$defs/evaluate_request" },
    { "$ref": "#/$defs/shutdown_request" },
    { "$ref": "#/$defs/acknowledgement" },
    { "$ref": "#/$defs/evaluate_response" },
    { "$ref": "#/$defs/materialize_response" },
    { "$ref": "#/$defs/execute_response" },
    { "$ref": "#/$defs/check_applicability_request" },
    { "$ref": "#/$defs/check_applicability_response" },
    { "$ref": "#/$defs/failure_response" },
    {
      "$ref": "#/$defs/execute_buffered_request"
    },
    {
      "$ref": "#/$defs/execute_buffered_response"
    },
    {"$ref": "#/$defs/managed_execute_response"},
    {"$ref": "#/$defs/managed_materialize_response"},
    {"$ref": "#/$defs/managed_evaluate_response"},
    {"$ref": "#/$defs/execute_stream_request"},
    {"$ref": "#/$defs/stream_checkpoint"},
    {"$ref": "#/$defs/stream_decision"},
    {"$ref": "#/$defs/execute_stream_response"}
  ]
}
