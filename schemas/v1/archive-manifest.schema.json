{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/archive-manifest.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Portable result archive inventory",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tool_version": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "executable": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "sha256",
          "size_bytes",
          "executable"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "tool_version",
    "files"
  ],
  "additionalProperties": false
}
