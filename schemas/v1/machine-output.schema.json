{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/machine-output.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand machine output envelope",
  "description": "A versioned command event, result, or structured diagnostic.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "kind": {
      "type": "string",
      "enum": ["event", "result", "diagnostic"]
    },
    "data": {}
  },
  "required": ["schema_version", "kind", "data"],
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "diagnostic" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "data": { "$ref": "common.schema.json#/$defs/diagnostic" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "result" },
          "data": {
            "type": "object",
            "properties": { "command": { "const": "init" } },
            "required": ["command"]
          }
        },
        "required": ["kind", "data"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/init_result" } }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "result" },
          "data": {
            "type": "object",
            "properties": { "command": { "const": "scaffold" } },
            "required": ["command"]
          }
        },
        "required": ["kind", "data"]
      },
      "then": {
        "properties": { "data": { "$ref": "#/$defs/scaffold_result" } }
      }
    }
  ],
  "$defs": {
    "changed_path": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["directory", "file"] },
        "action": { "enum": ["create", "modify"] }
      },
      "required": ["path", "kind", "action"],
      "if": { "properties": { "action": { "const": "modify" } } },
      "then": { "properties": { "kind": { "const": "file" } } },
      "additionalProperties": false
    },
    "scaffold_result": {
      "type": "object",
      "properties": {
        "command": { "const": "scaffold" },
        "component": { "enum": ["dataset", "problem", "implementation"] },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "dry_run": { "type": "boolean" },
        "manifest": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/changed_path" },
          "contains": {
            "type": "object",
            "properties": { "action": { "const": "modify" } },
            "required": ["action"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": ["command", "component", "name", "dry_run", "manifest", "paths"],
      "additionalProperties": false
    },
    "created_path": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["directory", "file"] }
      },
      "required": ["path", "kind"],
      "additionalProperties": false
    },
    "init_result": {
      "type": "object",
      "properties": {
        "command": { "const": "init" },
        "dry_run": { "type": "boolean" },
        "manifest": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/created_path" }
        }
      },
      "required": ["command", "dry_run", "manifest", "paths"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
