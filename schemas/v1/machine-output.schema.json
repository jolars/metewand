{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/machine-output.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand machine output envelope",
  "description": "A versioned command event, result, or structured diagnostic.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "kind": {
      "type": "string",
      "enum": ["event", "result", "diagnostic"]
    },
    "data": {}
  },
  "required": ["schema_version", "kind", "data"],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "data": {
            "type": "object",
            "properties": {
              "command": {
                "const": "check"
              }
            },
            "required": [
              "command",
              "workers"
            ]
          }
        },
        "required": [
          "kind",
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/worker_check_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "diagnostic"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "common.schema.json#/$defs/diagnostic"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "data": {
            "type": "object",
            "properties": {
              "command": {
                "const": "init"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "required": [
          "kind",
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/init_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "data": {
            "type": "object",
            "properties": {
              "command": {
                "const": "scaffold"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "required": [
          "kind",
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/scaffold_result"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          },
          "data": {
            "type": "object",
            "properties": {
              "command": {
                "const": "plan"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "required": [
          "kind",
          "data"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "experiments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "candidates": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "specifications": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "fresh_observations": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "profile-observation-policy.schema.json#/$defs/planned_observation"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "worker_check_result": {
      "type": "object",
      "properties": {
        "command": {
          "const": "check"
        },
        "benchmark": {
          "type": "string"
        },
        "manifest_hash": {
          "type": "string"
        },
        "problem_contracts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "repository_schemas": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_bundles": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "worker_launches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "implementation",
                  "problem_evaluator",
                  "dataset_materializer"
                ]
              },
              "worker_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "const": "verified_now"
              },
              "selected_capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "one_shot",
                    "applicability",
                    "fresh_sequence",
                    "buffered_profile",
                    "streaming_profile",
                    "problem_semantics"
                  ]
                }
              },
              "reported_capabilities": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "one_shot",
                    "applicability",
                    "fresh_sequence",
                    "buffered_profile",
                    "streaming_profile",
                    "problem_semantics"
                  ]
                }
              }
            },
            "required": [
              "component",
              "role",
              "worker_id",
              "evidence",
              "selected_capabilities",
              "reported_capabilities"
            ],
            "additionalProperties": false
          }
        },
        "reference_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "case_index": {
                "type": "integer",
                "minimum": 0
              },
              "metrics": {}
            },
            "required": [
              "problem",
              "case_index",
              "metrics"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "command",
        "benchmark",
        "manifest_hash",
        "problem_contracts",
        "repository_schemas",
        "source_bundles",
        "worker_launches",
        "workers",
        "reference_cases"
      ],
      "additionalProperties": false
    },
    "changed_path": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["directory", "file"] },
        "action": { "enum": ["create", "modify"] }
      },
      "required": ["path", "kind", "action"],
      "if": { "properties": { "action": { "const": "modify" } } },
      "then": { "properties": { "kind": { "const": "file" } } },
      "additionalProperties": false
    },
    "scaffold_result": {
      "type": "object",
      "properties": {
        "command": { "const": "scaffold" },
        "component": { "enum": ["dataset", "problem", "implementation"] },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "dry_run": { "type": "boolean" },
        "manifest": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/changed_path" },
          "contains": {
            "type": "object",
            "properties": { "action": { "const": "modify" } },
            "required": ["action"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "required": ["command", "component", "name", "dry_run", "manifest", "paths"],
      "additionalProperties": false
    },
    "created_path": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["directory", "file"] }
      },
      "required": ["path", "kind"],
      "additionalProperties": false
    },
    "init_result": {
      "type": "object",
      "properties": {
        "command": { "const": "init" },
        "dry_run": { "type": "boolean" },
        "manifest": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/created_path" }
        },
        "next_steps": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["command", "dry_run", "manifest", "paths"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
