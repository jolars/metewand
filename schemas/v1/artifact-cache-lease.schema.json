{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/artifact-cache-lease.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Artifact cache lease receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "enum": [
        "publication",
        "mapping",
        "read",
        "view"
      ]
    },
    "owner_pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "owner_pid",
    "tree_sha256"
  ],
  "additionalProperties": false
}
