{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/metrics.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand metrics envelope",
  "description": "A strict Metewand envelope around evaluator-owned metric data.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schema_version"
    },
    "schema": {
      "$ref": "common.schema.json#/$defs/schema_reference"
    },
    "data": { "type": "object" }
  },
  "required": ["schema_version", "schema", "data"],
  "additionalProperties": false
}
