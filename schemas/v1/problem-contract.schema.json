{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/problem-contract.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Metewand problem contract",
  "description": "The common, language-neutral envelope for a version-1 problem and its family-specific semantics.",
  "allOf": [{ "$ref": "#/$defs/body" }],
  "required": ["version", "name"],
  "unevaluatedProperties": false,
  "$defs": {
    "flat_body": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "family": { "$ref": "common.schema.json#/$defs/name" },
        "parameters": { "$ref": "common.schema.json#/$defs/compact_parameters" },
        "result": { "$ref": "common.schema.json#/$defs/compact_outputs" },
        "metrics": { "$ref": "common.schema.json#/$defs/compact_outputs" },
        "parameter-schema": {
          "$ref": "common.schema.json#/$defs/schema_declaration"
        },
        "dataset-schemas": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/schema_declaration" },
          "uniqueItems": true
        },
        "result-schema": {
          "$ref": "common.schema.json#/$defs/schema_declaration"
        },
        "metric-schema": {
          "$ref": "common.schema.json#/$defs/schema_declaration"
        },
        "semantics-schema": {
          "$ref": "common.schema.json#/$defs/schema_declaration"
        },
        "allowed-timing-scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cold_end_to_end", "prepare_and_execute", "execute_only"]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "supported-budgets": {
          "type": "array",
          "const": ["none"]
        },
        "semantics": {
          "type": "object",
          "properties": {
            "preprocessing": { "type": "object" },
            "validity": {
              "type": "object"
            },
            "one_shot_completion": {
              "type": "object"
            }
          }
        },
        "reference-cases": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference_case" }
        },
        "instrumented-scopes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "profile-observation-policy.schema.json#/$defs/scope"
          }
        }
      },
      "allOf": [
        { "not": { "required": ["parameters", "parameter-schema"] } },
        { "oneOf": [{ "required": ["result"] }, { "required": ["result-schema"] }] },
        { "oneOf": [{ "required": ["metrics"] }, { "required": ["metric-schema"] }] },
        {
          "if": {
            "properties": {
              "dataset-schemas": { "maxItems": 0 }
            },
            "required": ["dataset-schemas"]
          },
          "then": {
            "properties": {
              "reference-cases": {
                "items": { "not": { "required": ["dataset"] } }
              }
            }
          },
          "else": {
            "properties": {
              "reference-cases": {
                "items": { "required": ["dataset"] }
              }
            }
          }
        }
      ]
    },
    "reference_case": {
      "type": "object",
      "properties": {
        "dataset": { "oneOf": [{"$ref": "common.schema.json#/$defs/repository_path"}, {"type": "object"}] },
        "result": { "oneOf": [{"$ref": "common.schema.json#/$defs/repository_path"}, {"type": "object"}] },
        "expected-metrics": {
          "oneOf": [{"$ref": "common.schema.json#/$defs/repository_path"}, {"type": "object"}]
        },
        "expected-verdict": {"enum": ["invalid", "reached", "not_reached", "not_required"]}
      },
      "required": ["result", "expected-metrics"],
      "additionalProperties": false
    },
    "body": {
      "allOf": [{ "$ref": "#/$defs/flat_body" }],
      "required": ["family", "dataset-schemas"]
    }
  }
}
