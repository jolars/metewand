{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/profile-observation-policy.schema.json",
  "x-metewand-compatibility-version": 1,
  "type": "object",
  "properties": {
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "at_most",
        "at_least"
      ]
    },
    "threshold": {
      "type": "number"
    },
    "record-thresholds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "max-observations": {
      "description": "May be omitted when all resolved bindings use finite fresh_sequence schedules with the same expanded length, including prefixes. Binding resolution validates this condition.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max-trace-points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max-buffer-bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "terminal-reserve-bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max-active-time": {
      "type": "string",
      "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$"
    },
    "kind": {
      "const": "profile"
    },
    "version": {
      "const": 1
    },
    "implementations": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "delivery": {
                "const": "buffered_profile"
              },
              "measurement-basis": {
                "const": "instrumented"
              },
              "instrumented-scope": {
                "type": "string",
                "minLength": 1
              },
              "instrumentation-schema": {
                "$ref": "common.schema.json#/$defs/schema_declaration"
              },
              "instrumentation": {
                "type": "object"
              },
              "check-schedule": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "every": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "start": {
                        "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
                      }
                    },
                    "required": [
                      "every"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "indices": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "indices"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "geometric"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "ratio": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 9007199254740991
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "prefix": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "ratio",
                      "count"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "delivery",
              "measurement-basis",
              "instrumented-scope",
              "instrumentation-schema",
              "instrumentation",
              "check-schedule"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "delivery": {
                "const": "fresh_sequence"
              },
              "control-schema": {
                "$ref": "common.schema.json#/$defs/schema_declaration"
              },
              "schedule": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "explicit"
                      },
                      "controls": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "controls"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "linear"
                      },
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "number"
                      },
                      "step": {
                        "type": "number"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "prefix": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "field",
                      "start",
                      "step",
                      "count"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "geometric"
                      },
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "number"
                      },
                      "ratio": {
                        "type": "number"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "prefix": {
                        "type": "array",
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "field",
                      "start",
                      "ratio",
                      "count"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "controls": {
                "$ref": "common.schema.json#/$defs/compact_outputs"
              }
            },
            "required": [
              "delivery",
              "schedule"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "control-schema"
                ],
                "not": {
                  "required": [
                    "controls"
                  ]
                }
              },
              {
                "required": [
                  "controls"
                ],
                "not": {
                  "required": [
                    "control-schema"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "properties": {
              "delivery": {
                "const": "streaming_profile"
              },
              "measurement-basis": {
                "const": "executor_observed"
              },
              "check-schedule": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "every": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "start": {
                        "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
                      }
                    },
                    "required": [
                      "every"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "indices": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "minItems": 1,
                        "uniqueItems": true
                      }
                    },
                    "required": [
                      "indices"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "geometric"
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "ratio": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 9007199254740991
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "prefix": {
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "ratio",
                      "count"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "delivery",
              "measurement-basis",
              "check-schedule"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "max-checkpoint-bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "default-binding": {
      "$ref": "#/properties/implementations/additionalProperties"
    },
    "adaptive-budget": {
      "$ref": "#/$defs/adaptive_budget"
    }
  },
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "metric": [
      "direction",
      "threshold"
    ],
    "direction": [
      "metric",
      "threshold"
    ],
    "threshold": [
      "metric",
      "direction"
    ],
    "record-thresholds": [
      "metric",
      "direction",
      "threshold"
    ],
    "max-trace-points": [
      "max-buffer-bytes",
      "terminal-reserve-bytes"
    ],
    "max-buffer-bytes": [
      "max-trace-points",
      "terminal-reserve-bytes"
    ],
    "terminal-reserve-bytes": [
      "max-trace-points",
      "max-buffer-bytes"
    ]
  },
  "$defs": {
    "policy": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "at_most",
            "at_least"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "record-thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max-observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max-trace-points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max-buffer-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "terminal-reserve-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max-active-time": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$"
        },
        "adaptive-budget": {
          "$ref": "#/$defs/adaptive_budget"
        }
      },
      "required": [
        "max-observations"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "metric": [
          "direction",
          "threshold"
        ],
        "direction": [
          "metric",
          "threshold"
        ],
        "threshold": [
          "metric",
          "direction"
        ],
        "record-thresholds": [
          "metric",
          "direction",
          "threshold"
        ],
        "max-trace-points": [
          "max-buffer-bytes",
          "terminal-reserve-bytes"
        ],
        "max-buffer-bytes": [
          "max-trace-points",
          "terminal-reserve-bytes"
        ],
        "terminal-reserve-bytes": [
          "max-trace-points",
          "max-buffer-bytes"
        ],
        "adaptive-budget": [
          "metric",
          "direction",
          "threshold"
        ]
      },
      "allOf": [
        {
          "if": {
            "not": {
              "required": [
                "adaptive-budget"
              ]
            }
          },
          "then": {
            "required": [
              "max-active-time"
            ]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "clock-origin": {
          "type": "string",
          "minLength": 1
        },
        "included-work": {
          "type": "string",
          "minLength": 1
        },
        "excluded-preparation": {
          "type": "string",
          "minLength": 1
        },
        "metric-agreement": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "atol": {
                "type": "number",
                "minimum": 0
              },
              "rtol": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "atol",
              "rtol"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "clock-origin",
        "included-work",
        "excluded-preparation"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "properties": {
        "policy": {
          "allOf": [
            {
              "$ref": "#/$defs/policy"
            },
            {
              "required": [
                "max-trace-points",
                "max-buffer-bytes",
                "terminal-reserve-bytes",
                "max-active-time"
              ]
            }
          ]
        },
        "instrumented_scope": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "instrumentation": {
          "type": "object"
        },
        "check_schedule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "every": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "start": {
                  "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
                }
              },
              "required": [
                "every"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "indices": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "indices"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "policy",
        "instrumented_scope",
        "scope",
        "instrumentation",
        "check_schedule"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "resolved_specification_id": {
          "type": "string"
        },
        "logical_specification_id": {
          "type": "string"
        },
        "measurement_index": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "scheduled_points": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "accepted_points": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "consumed_time_ns": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "conservative_time_ns": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "status": {
          "enum": [
            "accepted",
            "censored",
            "partial"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "resolved_specification_id",
        "logical_specification_id",
        "measurement_index",
        "scheduled_points",
        "accepted_points",
        "consumed_time_ns",
        "conservative_time_ns",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "planned_observation": {
      "type": "object",
      "properties": {
        "observation_slot_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "attempt_slot_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "measurement_index": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "schedule_index": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "observation_control": {
          "type": "object"
        }
      },
      "required": [
        "observation_slot_id",
        "attempt_slot_id",
        "measurement_index",
        "schedule_index",
        "observation_control"
      ],
      "additionalProperties": false
    },
    "adaptive_budget": {
      "type": "object",
      "properties": {
        "initial-pilot-time": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$",
          "default": "1 s"
        },
        "minimum-time": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$",
          "default": "1 ms"
        },
        "fallback-time": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$"
        },
        "watchdog-grace": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$",
          "default": "10 s"
        },
        "growth-factor": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991,
          "default": 2
        },
        "multiplier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "default": 11
        }
      },
      "additionalProperties": false
    },
    "pilot_evidence": {
      "type": "object",
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "candidate_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "attempt_directory": {
          "$ref": "common.schema.json#/$defs/repository_path"
        },
        "status": {
          "enum": [
            "accepted",
            "censored",
            "failed",
            "superseded"
          ]
        },
        "convergence_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "observation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mw1-[a-z-]+-[0-9a-f]{64}$"
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "round",
        "limit_ns",
        "candidate_id",
        "attempt_id",
        "attempt_directory",
        "status",
        "convergence_time_ns",
        "observation_id"
      ],
      "additionalProperties": false
    },
    "adaptive_decision": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [1, 2]
        },
        "group_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "timing_basis": {
          "enum": ["instrumented", "cumulative_timed_wall_time", "streaming_active_time"]
        },
        "instrumented_scope": {
          "type": "string",
          "minLength": 1
        },
        "multiplier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "minimum_limit_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ceiling_limit_ns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "effective_limit_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reference_attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mw1-[a-z-]+-[0-9a-f]{64}$"
        },
        "reference_observation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^mw1-[a-z-]+-[0-9a-f]{64}$"
        },
        "reference_time_ns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          ]
        },
        "fallback": {
          "type": "boolean"
        },
        "pilots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pilot_evidence"
          }
        }
      },
      "required": [
        "schema_version",
        "group_id",
        "timing_basis",
        "multiplier",
        "minimum_limit_ns",
        "ceiling_limit_ns",
        "effective_limit_ns",
        "reference_attempt_id",
        "reference_observation_id",
        "reference_time_ns",
        "fallback",
        "pilots"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {"schema_version": {"const": 1}}
      },
      "then": {
        "properties": {"timing_basis": {"const": "instrumented"}},
        "required": ["instrumented_scope"]
      },
      "else": {
        "properties": {
          "timing_basis": {"enum": ["cumulative_timed_wall_time", "streaming_active_time"]},
          "instrumented_scope": false
        }
      }
    },
    "calibration_pilot": {
      "type": "object",
      "properties": {
        "group_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "round": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "limit_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "group_id",
        "round",
        "limit_ns"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "default-binding": {
                "properties": {
                  "delivery": {
                    "const": "buffered_profile"
                  }
                },
                "required": [
                  "delivery"
                ]
              }
            },
            "required": [
              "default-binding"
            ]
          },
          {
            "properties": {
              "implementations": {
                "not": {
                  "additionalProperties": {
                    "not": {
                      "properties": {
                        "delivery": {
                          "const": "buffered_profile"
                        }
                      },
                      "required": [
                        "delivery"
                      ]
                    }
                  }
                }
              }
            },
            "required": [
              "implementations"
            ]
          }
        ]
      },
