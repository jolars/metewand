{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/profile-observation-policy.schema.json",
  "x-metewand-compatibility-version": 1,
  "type": "object",
  "properties": {
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "at_most",
        "at_least"
      ]
    },
    "threshold": {
      "type": "number"
    },
    "record-thresholds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "max-observations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max-trace-points": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max-buffer-bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "terminal-reserve-bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "max-active-time": {
      "type": "string",
      "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$"
    },
    "kind": {
      "const": "profile"
    },
    "version": {
      "const": 1
    },
    "implementations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "delivery": {
                "const": "buffered_profile"
              },
              "measurement-basis": {
                "const": "instrumented"
              },
              "instrumented-scope": {
                "type": "string",
                "minLength": 1
              },
              "instrumentation-schema": {
                "$ref": "common.schema.json#/$defs/schema_declaration"
              },
              "instrumentation": {
                "type": "object"
              },
              "check-schedule": {
                "type": "object",
                "properties": {
                  "every": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "start": {
                    "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
                  }
                },
                "required": [
                  "every"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "delivery",
              "measurement-basis",
              "instrumented-scope",
              "instrumentation-schema",
              "instrumentation",
              "check-schedule"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "delivery": {
                "const": "fresh_sequence"
              },
              "control-schema": {
                "$ref": "common.schema.json#/$defs/schema_declaration"
              },
              "schedule": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "explicit"
                      },
                      "controls": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object"
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "controls"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "linear"
                      },
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "number"
                      },
                      "step": {
                        "type": "number"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "field",
                      "start",
                      "step",
                      "count"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "geometric"
                      },
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "number"
                      },
                      "ratio": {
                        "type": "number"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "kind",
                      "field",
                      "start",
                      "ratio",
                      "count"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "delivery",
              "control-schema",
              "schedule"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "max-observations",
    "max-active-time",
    "kind",
    "implementations"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "metric": [
      "direction",
      "threshold"
    ],
    "direction": [
      "metric",
      "threshold"
    ],
    "threshold": [
      "metric",
      "direction"
    ],
    "record-thresholds": [
      "metric",
      "direction",
      "threshold"
    ],
    "max-trace-points": [
      "max-buffer-bytes",
      "terminal-reserve-bytes"
    ],
    "max-buffer-bytes": [
      "max-trace-points",
      "terminal-reserve-bytes"
    ],
    "terminal-reserve-bytes": [
      "max-trace-points",
      "max-buffer-bytes"
    ]
  },
  "$defs": {
    "policy": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "at_most",
            "at_least"
          ]
        },
        "threshold": {
          "type": "number"
        },
        "record-thresholds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "max-observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max-trace-points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max-buffer-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "terminal-reserve-bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max-active-time": {
          "type": "string",
          "pattern": "^\\s*[1-9][0-9]*\\s*(ms|s|min|h)\\s*$"
        }
      },
      "required": [
        "max-observations",
        "max-active-time"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "metric": [
          "direction",
          "threshold"
        ],
        "direction": [
          "metric",
          "threshold"
        ],
        "threshold": [
          "metric",
          "direction"
        ],
        "record-thresholds": [
          "metric",
          "direction",
          "threshold"
        ],
        "max-trace-points": [
          "max-buffer-bytes",
          "terminal-reserve-bytes"
        ],
        "max-buffer-bytes": [
          "max-trace-points",
          "terminal-reserve-bytes"
        ],
        "terminal-reserve-bytes": [
          "max-trace-points",
          "max-buffer-bytes"
        ]
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "clock-origin": {
          "type": "string",
          "minLength": 1
        },
        "included-work": {
          "type": "string",
          "minLength": 1
        },
        "excluded-preparation": {
          "type": "string",
          "minLength": 1
        },
        "metric-agreement": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "atol": {
                "type": "number",
                "minimum": 0
              },
              "rtol": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "atol",
              "rtol"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "clock-origin",
        "included-work",
        "excluded-preparation"
      ],
      "additionalProperties": false
    },
    "selected": {
      "type": "object",
      "properties": {
        "policy": {
          "allOf": [
            {
              "$ref": "#/$defs/policy"
            },
            {
              "required": [
                "max-trace-points",
                "max-buffer-bytes",
                "terminal-reserve-bytes"
              ]
            }
          ]
        },
        "instrumented_scope": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "instrumentation": {
          "type": "object"
        },
        "check_schedule": {
          "type": "object",
          "properties": {
            "every": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "start": {
              "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
            }
          },
          "required": [
            "every"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "policy",
        "instrumented_scope",
        "scope",
        "instrumentation",
        "check_schedule"
      ],
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "properties": {
        "resolved_specification_id": {
          "type": "string"
        },
        "logical_specification_id": {
          "type": "string"
        },
        "measurement_index": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "scheduled_points": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "accepted_points": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "consumed_time_ns": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "conservative_time_ns": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "status": {
          "enum": [
            "accepted",
            "censored",
            "partial"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "resolved_specification_id",
        "logical_specification_id",
        "measurement_index",
        "scheduled_points",
        "accepted_points",
        "consumed_time_ns",
        "conservative_time_ns",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "planned_observation": {
      "type": "object",
      "properties": {
        "observation_slot_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "attempt_slot_id": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "measurement_index": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "schedule_index": {
          "$ref": "common.schema.json#/$defs/safe_nonnegative_integer"
        },
        "observation_control": {
          "type": "object"
        }
      },
      "required": [
        "observation_slot_id",
        "attempt_slot_id",
        "measurement_index",
        "schedule_index",
        "observation_control"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "implementations": {
            "not": {
              "additionalProperties": {
                "properties": {
                  "delivery": {
                    "const": "fresh_sequence"
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "max-trace-points",
          "max-buffer-bytes",
          "terminal-reserve-bytes"
        ]
      }
    }
  ]
}
