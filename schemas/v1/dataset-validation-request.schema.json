{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v1/dataset-validation-request.schema.json",
  "x-metewand-compatibility-version": 1,
  "title": "Contract dataset validation command request",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "contract_id": {
      "$ref": "common.schema.json#/$defs/identity"
    },
    "dataset_dir": {
      "type": "string",
      "pattern": "^/"
    },
    "manifest": {
      "$ref": "common.schema.json#/$defs/repository_path"
    }
  },
  "required": [
    "version",
    "contract_id",
    "dataset_dir",
    "manifest"
  ],
  "additionalProperties": false
}
