{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metewand://schemas/v2/shared-cache-record.schema.json",
  "x-metewand-compatibility-version": 2,
  "title": "Portable shared artifact cache catalog delta and checkpoint",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previous_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "roots": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "pending": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "objects",
        "roots",
        "pending"
      ],
      "additionalProperties": false
    },
    "delta": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "register"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "marker": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "digest",
            "marker"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "root"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "add": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "digest",
            "name",
            "add"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "pending"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "detached": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "digest",
            "detached"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "forget"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "kind",
            "digest"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "sequence",
    "previous_sha256"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "sequence": {
        "const": 0
      }
    }
  },
  "then": {
    "required": [
      "checkpoint"
    ],
    "not": {
      "required": [
        "delta"
      ]
    }
  },
  "else": {
    "required": [
      "delta"
    ]
  }
}
