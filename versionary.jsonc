{
  "$schema": "https://raw.githubusercontent.com/jolars/versionary/main/schemas/config.json",
  "version": 1,
  "review-mode": "pr",
  "release-type": "rust",
  "monorepo-mode": "fixed",
  "allow-stable-major": true,
  "include-commit-authors": true,
  "release-reference-comments": "best-effort",
  "packages": {
    ".": {},
    "packages/python": {
      "release-type": "python",
      "package-name": "metewand",
      // Remove once the Action uses Versionary's nested Python discovery fix.
      "extra-files": [
        {
          "type": "regex",
          "path": "src/metewand/__init__.py",
          "pattern": "__version__ = \"([^\"]+)\"",
          "expected-matches": 1
        }
      ]
    }
  }
}
